}

.app-submenu {
    position: relative;
}

.app-submenu-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #f1f1f1;
    text-align: left;
    font-size: 12px;
    font-weight: 700;
    cursor: default;
}

