}

/* Input group con boton + */
.input-group {
    display: flex;
    gap: 5px;
    align-items: stretch;
}

.input-group .form-control {
    flex: 1;
}

.input-group-append {
    display: flex;
}

.input-group-append .btn {
    padding: 8px 12px;
    border-radius: 0 4px 4px 0;
    min-width: 34px;
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
}

/* Select buscable */
.select-buscable-wrapper {
    position: relative;
}

.select-buscable-input {
    width: 100%;
    padding: 8px;
    margin-bottom: 5px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
}

.select-buscable {
    width: 100%;
    max-height: 200px;
    overflow-y: auto;
}

/* ============================================
   MODAL EQUIPO DESDE FACTURAS - Más grande y con grid
   ============================================ */

#modalEquipo.show,
#modalEquipo[aria-hidden="false"],
#modalEquipoFactura.show,
#modalEquipoFactura[aria-hidden="false"] {
    display: flex !important;
    align-items: flex-start;
    padding-top: 4px;
    padding-bottom: 2px;
}

#modalEquipo .modal-equipo,
#modalEquipoFactura .modal-equipo {
    max-width: 1260px;
    width: 95%;
    border-radius: 14px;
    box-shadow: 0 18px 45px rgba(0,0,0,0.25);
    margin: 0 auto;
    height: calc(100vh - 12px);
    max-height: calc(100vh - 12px);
    min-height: calc(100vh - 12px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

#modalEquipo .modal-equipo-header,
#modalEquipoFactura .modal-equipo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid #e6e6e6;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
}

#modalEquipo .modal-equipo-header h2,
#modalEquipoFactura .modal-equipo-header h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
}

#modalEquipo .modal-equipo-header .modal-cerrar,
#modalEquipoFactura .modal-equipo-header .modal-cerrar {
    font-size: 20px;
}

#modalEquipo .modal-equipo-body,
#modalEquipoFactura .modal-equipo-body {
    display: flex;
    flex-direction: column;
    padding: 8px 12px 0;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow: hidden;
}

#modalEquipo .modal-equipo-layout,
#modalEquipoFactura .modal-equipo-layout {
    display: grid;
    grid-template-columns: minmax(390px, 440px) minmax(0, 1fr);
    gap: 6px;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
}

#modalEquipo .modal-equipo-col-main .form-grupo,
#modalEquipoFactura .modal-equipo-col-main .form-grupo {
    margin-bottom: 9px;
}

#modalEquipo .modal-equipo-col-main .form-grupo .input-group:has(select.form-control),
#modalEquipoFactura .modal-equipo-col-main .form-grupo .input-group:has(select.form-control) {
    width: 100%;
    max-width: 440px;
}

#modalEquipo .modal-equipo-col-main select.form-control,
#modalEquipoFactura .modal-equipo-col-main select.form-control {
    width: 100%;
    max-width: none;
}

#modalEquipo #equipoSerie,
#modalEquipo #equipoPrecio,
#modalEquipoFactura #equipoFacturaSerie,
#modalEquipoFactura #equipoFacturaPrecio {
    width: 100%;
    max-width: 440px;
}

#modalEquipo .modal-equipo-col-side .form-grupo:last-child,
#modalEquipoFactura .modal-equipo-col-side .form-grupo:last-child {
    margin-bottom: 0;
}

#modalEquipo .modal-equipo-col-side,
#modalEquipoFactura .modal-equipo-col-side {
    border-left: 1px solid #e2e8f0;
    padding-left: 8px;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    grid-template-areas:
        "obs attr"
        "det attr"
        "fac attr";
    gap: 6px;
    align-content: start;
    align-items: start;
}

#modalEquipo .modal-equipo-col-side > .form-grupo:first-child,
#modalEquipoFactura .modal-equipo-col-side > .form-grupo:first-child {
    grid-area: obs;
    margin-bottom: 0;
    margin-top: 0;
    padding: 9px 10px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    width: 100%;
    box-sizing: border-box;
}

#modalEquipo .modal-equipo-col-side .form-grupo,
#modalEquipoFactura .modal-equipo-col-side .form-grupo {
    margin-bottom: 0;
}

#modalEquipo #equipoAtributosBlock,
#modalEquipoFactura #equipoFacturaAtributosBlock {
    grid-area: attr;
    margin-bottom: 0;
}

#modalEquipo .equipo-atributos-header,
#modalEquipoFactura .equipo-atributos-header {
    align-items: center;
    margin-bottom: 4px;
}

#modalEquipo .equipo-atributos-header .btn-agregar-entidad,
#modalEquipoFactura .equipo-atributos-header .btn-agregar-entidad {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-left: auto;
    padding: 0;
}

#modalEquipo .btn-atributos-gestor,
#modalEquipoFactura .btn-atributos-gestor {
    font-size: 18px;
    line-height: 1;
}

#modalEquipo .equipo-atributo-label,
#modalEquipoFactura .equipo-atributo-label {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 3px;
}

#modalEquipo .equipo-atributo-control-row,
#modalEquipoFactura .equipo-atributo-control-row {
    display: flex;
    align-items: center;
    gap: 6px;
