                    $q->where('id', 'like', $search)
                      ->orWhere('nombre', 'like', $search)
                      ->orWhere('codigo', 'like', $search)
                      ->orWhere('ciudad', 'like', $search)
                      ->orWhere('provincia', 'like', $search)
                      ->orWhere('telefono', 'like', $search);
