    ];

    protected $casts = [
        'fecha_movimiento' => 'date',
        'cantidad' => 'decimal:4',
        'precio_unitario' => 'decimal:4',
    ];

    public function material()
    {
        return $this->belongsTo(Material::class, 'material_id');
    }
}
