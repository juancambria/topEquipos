    };

    const applyBounds = (windowEl, bounds) => {
        windowEl.style.left = `${bounds.left}px`;
        windowEl.style.top = `${bounds.top}px`;
        windowEl.style.width = `${bounds.width}px`;
        windowEl.style.height = `${bounds.height}px`;
