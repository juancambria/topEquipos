        return response()->json($equipos->map(function ($equipo) {
            return [
                'id' => $equipo->id,
                'texto' => $equipo->serie . ' - ' . ($equipo->marca->marca ?? '') . ' ' . ($equipo->modelo->modelo ?? ''),
                'serie' => $equipo->serie,
            ];
        }));
    }

    /**
