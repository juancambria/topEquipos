}

#modalFactura .modal-body {
    max-height: calc(105vh - 120px);
}

/* Panel Totales Rediseñado */
.totales-panel-redisenado {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
}

.totales-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 18px;
}

.totales-item {
    background: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 15px;
}

.totales-item-header {
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid #007bff;
}

.totales-item-header label {
    font-size: 14px;
    font-weight: 700;
    color: #007bff;
    margin: 0;
    text-transform: uppercase;
}

.totales-item-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.totales-input-group {
    display: flex;
    align-items: center;
    gap: 10px;
}

.totales-input-group .label {
    font-size: 13px;
    color: #555;
    white-space: nowrap;
}

.totales-input-group .form-control {
    width: 100px;
    text-align: right;
}

.totales-display {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 10px;
    background: #fff;
    border-radius: 4px;
    border: 1px solid #ddd;
}

.totales-display .label {
    font-size: 13px;
    color: #555;
}

.totales-display .valor {
    font-size: 15px;
    font-weight: 700;
    font-family: 'Courier New', monospace;
    color: #333;
}

.totales-display.neto {
    background: #e9ecef;
    border-color: #ced4da;
}

.totales-display.neto .label {
    font-weight: 600;
    color: #333;
}

.totales-display.neto .valor {
    font-size: 17px;
}

.totales-display.total-final {
    background: #007bff;
    border-color: #0056b3;
    margin-top: 5px;
}

.totales-display.total-final .label,
.totales-display.total-final .valor {
    color: #fff;
    font-size: 18px;
}

.observacion-section {
    margin-bottom: 20px;
}

.observacion-section .form-group {
    margin-bottom: 0;
}

.observacion-section label {
    font-size: 13px;
    font-weight: 600;
    color: #333;
}

.observacion-section textarea {
    resize: vertical;
    min-height: 90px;
}

.totales-footer {
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    padding-top: 15px;
    border-top: 2px solid #007bff;
}

.totales-footer .btn-lg {
    padding: 12px 30px;
    font-size: 16px;
    font-weight: 600;
}

@media (max-width: 900px) {
    .totales-grid {
        grid-template-columns: 1fr;
    }
}

.modal-content {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
}

.modal-header {
    padding: 15px 20px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    background: #f8f9fa;
    border-radius: 8px 8px 0 0;
}

.modal-header h5 {
    margin: 0;
    font-size: 18px;
}

.modal-header .close {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
}

.modal-body {
    padding: 20px;
    overflow-y: auto;
    flex: 1;
    max-height: calc(90vh - 140px);
}

.modal-footer {
    padding: 15px 20px;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    flex-shrink: 0;
    background: #f8f9fa;
    border-radius: 0 0 8px 8px;
}

/* Formularios */
.form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
    flex-wrap: wrap;
}

.form-group {
    flex: 1;
    min-width: 150px;
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.form-group.flex-2 {
    flex: 2;
    min-width: 300px;
}

.form-group label {
    font-size: 13px;
    font-weight: 600;
    color: #333;
}

.form-control {
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
}

.form-control:focus {
    border-color: #007bff;
    outline: none;
    box-shadow: 0 0 0 2px rgba(0,123,255,0.25);
}

.form-control.text-right {
    text-align: right;
}

/* Datos factura */
.datos-factura {
    background: #fafafa;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    border: 1px solid #eee;
}

.datos-factura .form-row {
    margin-bottom: 12px;
}

/** Número de factura #####-######## (alineación tipo máscara) */
.datos-factura .input-numero-factura {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    max-width: 15rem;
}

/* Tabla detalles */
.detalles-section {
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    margin-bottom: 20px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 15px;
    background: #f0f0f0;
    border-bottom: 1px solid #ddd;
}

.section-header h6 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
}

.detalles-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.detalles-table thead tr {
    background: #e9ecef;
}

.detalles-table th,
.detalles-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #eee;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.detalles-table th {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: #555;
    text-align: center;
}

.detalles-table tbody tr:hover {
    background: #f5f5f5;
}

.detalles-table tbody tr td:first-child {
    text-align: center;
}

.detalles-table tbody tr td:last-child {
    text-align: center;
}

.detalles-table .form-control {
    width: 100%;
    padding: 6px 8px;
    font-size: 13px;
    box-sizing: border-box;
}

.detalles-table input[type="number"].form-control {
    text-align: right;
}

/* Anchos de columnas */
.detalles-table th:nth-child(1),
.detalles-table td:nth-child(1) { width: 100px; }
.detalles-table th:nth-child(2),
.detalles-table td:nth-child(2) { width: 120px; }
.detalles-table th:nth-child(3),
.detalles-table td:nth-child(3) { width: 70px; }
.detalles-table th:nth-child(4),
.detalles-table td:nth-child(4) { width: auto; min-width: 150px; }
.detalles-table th:nth-child(5),
.detalles-table td:nth-child(5) { width: 100px; }
.detalles-table th:nth-child(6),
.detalles-table td:nth-child(6) { width: 90px; }
.detalles-table th:nth-child(7),
.detalles-table td:nth-child(7) { width: 70px; }
.detalles-table th:nth-child(8),
.detalles-table td:nth-child(8) { width: 100px; }
.detalles-table th:nth-child(9),
.detalles-table td:nth-child(9) { width: 100px; }
.detalles-table th:nth-child(10),
.detalles-table td:nth-child(10) { width: 78px; overflow: visible; text-overflow: clip; }

/* Totales panel */
.totales-panel {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 15px 20px;
    margin-bottom: 20px;
}

.totales-row-flex {
    display: flex;
    gap: 20px;
}

.totales-col {
    flex: 1;
}

.totales-col.izquierda {
    max-width: 280px;
}

.totales-col.centro {
    max-width: 200px;
}

.totales-col.derecha {
    max-width: 200px;
    margin-left: auto;
}

.totales-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.totales-group.final {
    background: #f8f9fa;
    padding: 12px;
    border-radius: 6px;
    border: 1px solid #e0e0e0;
}

.total-row-inline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.total-row-inline .label {
    font-size: 12px;
    color: #555;
    white-space: nowrap;
}

.total-row-inline .valor {
    font-size: 13px;
    font-weight: 600;
    color: #333;
    font-family: 'Courier New', monospace;
    text-align: right;
    min-width: 80px;
}

.total-row-inline .form-control.input-numero {
    width: 80px;
    text-align: right;
    font-size: 13px;
    padding: 6px 8px;
}

.total-row-inline.neto {
    padding-bottom: 8px;
    border-bottom: 2px solid #007bff;
    margin-bottom: 5px;
}

.total-row-inline.neto .label {
    font-size: 13px;
    font-weight: 600;
    color: #333;
}

.total-row-inline.neto .valor {
    font-size: 15px;
    font-weight: 700;
}

.total-row-inline.total {
    background: #007bff;
    padding: 8px 10px;
    border-radius: 4px;
    margin-top: 5px;
}

.total-row-inline.total .label {
    color: #fff;
    font-size: 14px;
    font-weight: 700;
}

.total-row-inline.total .valor {
    color: #fff;
    font-size: 18px;
    font-weight: 700;
}

/* Alerts */
.alert {
    padding: 12px 15px;
    border-radius: 6px;
    margin-bottom: 15px;
    font-size: 13px;
}

.alert-warning {
    background: #fff3cd;
    border: 1px solid #ffc107;
    color: #856404;
}

.alert-success {
    background: #d4edda;
    border: 1px solid #28a745;
    color: #155724;
}

.alert-danger {
    background: #f8d7da;
    border: 1px solid #dc3545;
    color: #721c24;
}

.alert-info {
    background: #d1ecf1;
    border: 1px solid #17a2b8;
    color: #0c5460;
}

/* Botones */
.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: background-color 0.2s;
}

.btn-primary { background: #007bff; color: #fff; }
.btn-primary:hover { background: #0056b3; }

.btn-secondary { background: #6c757d; color: #fff; }
.btn-secondary:hover { background: #545b62; }

.btn-success { background: #28a745; color: #fff; }
.btn-danger { background: #dc3545; color: #fff; }
.btn-warning { background: #ffc107; color: #212529; }
.btn-sm { padding: 6px 12px; font-size: 12px; }

.btn-icon {
    padding: 6px 8px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.2s;
}

.btn-icon.btn-view { background: #17a2b8; color: #fff; }
.btn-icon.btn-edit { background: #007bff; color: #fff; }
.btn-icon.btn-delete { background: #dc3545; color: #fff; }

/* Responsive */
@media (max-width: 768px) {
    .facturas-header {
        flex-direction: column;
        align-items: flex-start;
    }
    .facturas-toolbar {
        flex-wrap: wrap;
        max-width: 100%;
    }
    .search-wrapper {
        width: 100%;
    }
    .filters-form { flex-direction: column; }
    .form-row { flex-direction: column; }
    .totales-row-flex { flex-direction: column; }
    .totales-col.izquierda,
    .totales-col.centro,
    .totales-col.derecha { max-width: 100%; }
    .totales-col.derecha { margin-left: 0; }
    .modal-dialog { margin: 10px; max-width: 100%; }
    .modal-body { max-height: calc(90vh - 120px); }
    #modalFactura .modal-body { max-height: calc(96vh - 100px); }
}

/* Progress bar */
.progress-container {
    width: 100%;
    background-color: #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    height: 25px;
    margin-top: 15px;
}

.progress-bar {
    height: 100%;
    background: #007bff;
    color: white;
    text-align: center;
    line-height: 25px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 10px;
    transition: width 0.3s ease;
}

/* Scrollbar */
.modal-body::-webkit-scrollbar { width: 8px; }
.modal-body::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
.modal-body::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }
.modal-body::-webkit-scrollbar-thumb:hover { background: #a1a1a1; }

/* ============================================
   MODALES AUXILIARES (Marca, Modelo, Ubicacion, Sector)
   ============================================ */

/* Por encima de #modalProveedor (120000) y otros overlays anidados en facturas */
#modalConfirmFacturasAccion {
    z-index: 130000;
}

.modal-overlay {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.6);
    align-items: center;
    justify-content: center;
}

.modal-overlay[aria-hidden="false"] {
    display: flex !important;
}

.modal-sector {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    max-width: 480px;
    width: 90%;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.modal-sector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    border-bottom: 1px solid #eee;
    background: #f8f9fa;
}

.modal-sector-header h2 {
    margin: 0;
    font-size: 18px;
    color: #333;
}

.modal-cerrar {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
    padding: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background-color 0.2s;
}

.modal-cerrar:hover {
    background-color: #e0e0e0;
}

.modal-sector-body {
    padding: 20px;
    overflow-y: auto;
    flex: 1;
}

.modal-sector-body .form-grupo {
    margin-bottom: 15px;
}

.modal-sector-body .form-grupo label {
    display: block;
    margin-bottom: 5px;
    font-size: 13px;
    font-weight: 600;
    color: #333;
}

.modal-sector-body .form-grupo input,
.modal-sector-body .form-grupo select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
}

.modal-sector-body .form-grupo input:focus,
.modal-sector-body .form-grupo select:focus {
    border-color: #007bff;
    outline: none;
    box-shadow: 0 0 0 2px rgba(0,123,255,0.25);
}

.modal-sector-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 15px 20px;
    border-top: 1px solid #eee;
