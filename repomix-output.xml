  function validarCantidad(input) {
    if (!input) return;
    const v = input.value;
    if (!v || v === '.') return;
    const n = parseFloat(v);
    if (Number.isNaN(n) || n < 0) return;
    if (v.includes('.')) {
      const [, dec = ''] = v.split('.');
      if (dec.length > 1) input.value = v.slice(0, -1);
    }
    if (parseFloat(input.value) > 99.9) input.value = v.slice(0, -1);
  }

