    cargarModelosFacturaPorMarcaYSeleccionar,
    cargarSectoresFacturaPorUbicacionYSeleccionar,
    cargarModelosPorMarcaYSeleccionar,
    cargarSectoresPorUbicacionYSeleccionar,
    mostrarModalEquipoActual,
