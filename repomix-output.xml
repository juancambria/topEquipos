    background: rgba(255,255,255,0.12);
}

.app-submenu-arrow {
    font-size: 10px;
    opacity: 0.9;
}

.app-submenu-panel {
    position: absolute;
    top: -8px;
    left: 100%;
    min-width: 220px;
    display: none;
    flex-direction: column;
    padding: 8px;
    border: 1px solid #2f2f2f;
    border-radius: 12px;
    background: rgba(39, 39, 39, 0.98);
    box-shadow: 0 14px 30px rgba(0,0,0,0.35);
