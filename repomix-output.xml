        $this->validarCadena((int) $data['herramienta_familia_id'], (int) $data['herramienta_marca_id'], (int) $data['herramienta_modelo_id']);
        $item->update($data);
        return response()->json(['success' => true, 'message' => 'Registro actualizado correctamente']);
