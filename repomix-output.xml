    const openRouteInWindow = link => {
        const routeKey = normalizeUrl(link.href);
        link.dataset.routeKey = routeKey;

        const existingWindow = [...windows.values()].find(item => item.routeKey === routeKey)?.windowEl;
        if (existingWindow) {
