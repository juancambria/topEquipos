<file path="public/css/toast.css">
/* Toast notifications */
.toast-container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
}

.toast {
    background: rgba(0, 0, 0, 0.9);
    color: white;
    padding: 15px 25px;
    border-radius: 8px;
    font-size: 14px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    animation: toastFadeIn 0.3s ease-out, toastFadeOut 0.5s ease-in 3s forwards;
    max-width: 400px;
    word-wrap: break-word;
}

.toast.toast-success {
    background: rgba(39, 174, 96, 0.95);
}

.toast.toast-error {
    background: rgba(231, 76, 60, 0.95);
}

.toast.toast-warning {
    background: rgba(243, 156, 18, 0.95);
}

@keyframes toastFadeIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes toastFadeOut {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(-20px);
    }
}

/* Modal de confirmación */
.modal-confirmacion-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100000;
    isolation: isolate;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.modal-confirmacion-overlay.activo {
    opacity: 1;
    visibility: visible;
}

.modal-confirmacion {
    background: white;
    border-radius: 12px;
    padding: 25px;
    max-width: 450px;
    width: 90%;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    transform: scale(0.9);
    transition: transform 0.3s ease;
}

.modal-confirmacion-overlay.activo .modal-confirmacion {
    transform: scale(1);
}

.modal-confirmacion-titulo {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 15px;
    color: #333;
}

.modal-confirmacion-mensaje {
    font-size: 14px;
    color: #666;
    margin-bottom: 20px;
    line-height: 1.5;
}

.modal-confirmacion-observacion {
    margin-bottom: 20px;
}

.modal-confirmacion-observacion label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: #555;
    margin-bottom: 8px;
}

.modal-confirmacion-observacion textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 14px;
    resize: vertical;
    min-height: 80px;
    font-family: inherit;
}

.modal-confirmacion-observacion textarea:focus {
    outline: none;
    border-color: #333;
}

.modal-confirmacion-botones {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
}

.modal-confirmacion-botones .btn {
    padding: 10px 20px;
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
}

/* Mismo criterio que .btn.btn-secundario (No / cancelar) */
.modal-confirmacion-botones .btn.btn-cancelar {
    background: #6c757d;
    color: #fff;
    border: 1px solid #5a6268;
    font-weight: 500;
}

.modal-confirmacion-botones .btn.btn-cancelar:hover {
    background: #5a6268;
    border-color: #4e555b;
    color: #fff;
}

.modal-confirmacion-botones .btn-confirmar {
    background: #218838;
    color: #fff;
    border: 1px solid #1e7e34;
    font-weight: 500;
}

.modal-confirmacion-botones .btn-confirmar:hover {
    background: #1c7430;
    border-color: #186429;
}

.modal-confirmacion-overlay.modal-confirmacion--peligro .modal-confirmacion-botones .btn-confirmar {
    background: #c82333;
    border-color: #bd2130;
}

.modal-confirmacion-overlay.modal-confirmacion--peligro .modal-confirmacion-botones .btn-confirmar:hover {
    background: #bd2130;
    border-color: #a71d2a;
}

.modal-confirmacion-botones .btn-confirmar:disabled {
    background: #999;
    border-color: #999;
    cursor: not-allowed;
}

/* Una sola caja de texto: subrayar solo la 1ª letra (Alt+N → N, Alt+S → S), sin partir la palabra */
.modal-confirmacion-botones .modal-btn-accesskey-word {
    letter-spacing: 0;
    font-kerning: normal;
}

.modal-confirmacion-botones .modal-btn-accesskey-word::first-letter {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
}
