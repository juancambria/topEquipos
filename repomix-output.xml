    abrirAltaEquipoPendiente,
    omitirEquipoActualFactura,
    omitirHerramientaActualFactura: () => omitirAltaActualFactura('Herramienta'),
    omitirMaterialActualFactura: () => omitirAltaActualFactura('Material'),
